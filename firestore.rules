rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function hasUserDoc() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function userData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isAdmin() {
      return hasUserDoc()
        && userData().role == 'admin'
        && userData().isActive == true;
    }

    function isSupervisor() {
      return hasUserDoc()
        && userData().role == 'supervisor'
        && userData().isActive == true;
    }

    function isAllowedRole(role) {
      return role in ['admin', 'supervisor'];
    }

    function isValidUserCreate(userId) {
      return request.resource.data.keys().hasAll(['uid', 'email', 'role', 'isActive', 'createdAt'])
        && request.resource.data.uid == userId
        && request.resource.data.email is string
        && isAllowedRole(request.resource.data.role)
        && request.resource.data.isActive is bool
        && request.resource.data.createdAt is timestamp;
    }

    function isValidUserUpdate(userId) {
      return request.resource.data.uid == resource.data.uid
        && request.resource.data.uid == userId
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.email is string
        && isAllowedRole(request.resource.data.role)
        && request.resource.data.isActive is bool;
    }

    function isSelfPasswordChange(userId) {
      return isSignedIn()
        && request.auth.uid == userId
        && resource.data.mustChangePassword == true
        && request.resource.data.mustChangePassword == false
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'mustChangePassword',
          'updatedAt'
        ])
        && request.resource.data.updatedAt is timestamp;
    }

    function isValidServicioSupervisorCreate() {
      return request.resource.data.keys().hasAll([
          'uidSupervisor',
          'estado',
          'apertura',
          'controlInstalaciones',
          'serviciosExtraordinarios',
          'createdAt',
          'expiresAt',
          'updatedAt',
          'updatedBy'
        ])
        && request.resource.data.uidSupervisor == request.auth.uid
        && request.resource.data.estado == 'abierto'
        && request.resource.data.apertura is map
        && request.resource.data.controlInstalaciones is list
        && request.resource.data.serviciosExtraordinarios is list
        && request.resource.data.createdAt is timestamp
        && request.resource.data.expiresAt is timestamp
        && request.resource.data.updatedAt is timestamp
        && request.resource.data.updatedBy == request.auth.uid;
    }

    function isValidServicioSupervisorUpdate() {
      return request.resource.data.uidSupervisor == resource.data.uidSupervisor
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.apertura == resource.data.apertura
        && request.resource.data.updatedBy == request.auth.uid
        && request.resource.data.updatedAt is timestamp
        && resource.data.estado == 'abierto'
        && (
          request.resource.data.estado == 'abierto'
          || (
            request.resource.data.estado == 'cerrado'
            && request.resource.data.cierre is map
            && request.resource.data.cierre.fechaHora is timestamp
            && request.resource.data.expiresAt is timestamp
          )
        );
    }

    function isValidServicioJefeCreate() {
      return request.resource.data.keys().hasAll([
          'uidJefe',
          'estado',
          'apertura',
          'createdAt',
          'updatedAt',
          'updatedBy'
        ])
        && request.resource.data.uidJefe == request.auth.uid
        && request.resource.data.estado == 'abierto'
        && request.resource.data.apertura is map
        && request.resource.data.createdAt is timestamp
        && request.resource.data.updatedAt is timestamp
        && request.resource.data.updatedBy == request.auth.uid;
    }

    function isValidServicioJefeUpdate() {
      return request.resource.data.uidJefe == resource.data.uidJefe
        && request.resource.data.createdAt == resource.data.createdAt
        // La apertura se puede actualizar solo para registrar incorporaciones
        // tardías; la identidad del plan y su fecha no cambian.
        && request.resource.data.apertura.nroPlanOperaciones == resource.data.apertura.nroPlanOperaciones
        && request.resource.data.apertura.fechaApertura == resource.data.apertura.fechaApertura
        && request.resource.data.updatedBy == request.auth.uid
        && request.resource.data.updatedAt is timestamp
        && resource.data.estado == 'abierto'
        && (
          request.resource.data.estado == 'abierto'
          || (
            request.resource.data.estado == 'cerrado'
            && request.resource.data.cierre is map
            && request.resource.data.cierre.fechaCierre is timestamp
            && request.resource.data.expiresAt is timestamp
          )
        );
    }

    match /users/{userId} {
      allow read: if isAdmin() || (isSignedIn() && request.auth.uid == userId);
      allow create: if isAdmin() && isValidUserCreate(userId);
      allow update: if (isAdmin() && isValidUserUpdate(userId))
        || isSelfPasswordChange(userId);
      allow delete: if isAdmin();
    }

    match /users_archivados/{userId} {
      allow read: if isAdmin();
      allow create: if isAdmin()
        && request.resource.data.archivedBy == request.auth.uid
        && request.resource.data.archivedAt is timestamp;
      allow update, delete: if false;
    }

    match /servicios_supervisor/{servicioId} {
      allow read: if isAdmin() || (isSupervisor() && request.auth.uid == resource.data.uidSupervisor);
      allow create: if isSupervisor()
        && isValidServicioSupervisorCreate();
      allow update: if isSupervisor()
        && request.auth.uid == resource.data.uidSupervisor
        && isValidServicioSupervisorUpdate();
      allow delete: if isAdmin();
    }

    match /servicios_jefe_operativo/{servicioId} {
      allow read: if isAdmin() || (isSupervisor() && request.auth.uid == resource.data.uidJefe);
      allow create: if isSupervisor()
        && isValidServicioJefeCreate();
      allow update: if isSupervisor()
        && request.auth.uid == resource.data.uidJefe
        && isValidServicioJefeUpdate();
      allow delete: if isAdmin();
    }

    match /servicios_activos/{lockId} {
      // Un bloqueo por usuario y tipo: {uid}_supervisor o {uid}_jefe.
      allow read: if isAdmin()
        || (
          isSignedIn()
          && (
            lockId == request.auth.uid + '_supervisor'
            || lockId == request.auth.uid + '_jefe'
            || lockId == request.auth.uid
          )
        );
      allow create: if isSupervisor()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.tipo in ['supervisor', 'jefe']
        && (
          (request.resource.data.tipo == 'supervisor' && lockId == request.auth.uid + '_supervisor')
          || (request.resource.data.tipo == 'jefe' && lockId == request.auth.uid + '_jefe')
        )
        && request.resource.data.servicioId is string
        && request.resource.data.createdAt is timestamp;
      allow delete: if isAdmin()
        || (
          isSupervisor()
          && (
            lockId == request.auth.uid + '_supervisor'
            || lockId == request.auth.uid + '_jefe'
            || lockId == request.auth.uid
          )
        );
      allow update: if false;
    }

    match /servicios_supervisor_archivados/{servicioId} {
      allow read: if isAdmin();
      allow create: if isAdmin()
        && request.resource.data.archivedBy == request.auth.uid
        && request.resource.data.archivedAt is timestamp;
      allow update, delete: if false;
    }

    match /servicios_jefe_operativo_archivados/{servicioId} {
      allow read: if isAdmin();
      allow create: if isAdmin()
        && request.resource.data.archivedBy == request.auth.uid
        && request.resource.data.archivedAt is timestamp;
      allow update, delete: if false;
    }

    match /auditoria/{registroId} {
      allow read: if isAdmin();
      allow create: if isAdmin()
        && request.resource.data.actorUid == request.auth.uid
        && request.resource.data.creadoEn is timestamp;
      allow update, delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
